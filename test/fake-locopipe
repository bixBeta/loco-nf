#!/usr/bin/env bash
# Stand-in for the loco-pipe CLI inside the image, used by CI via --locopipebin.
#
# -stub-run skips the real script block entirely, so the actual command line is
# never exercised. Pointing --locopipebin at this script runs the module for
# real and records what was asked for so CI can assert on it.
#
# It also enforces the contracts that matter: init lays out the project the way
# upstream does, and start refuses to run without the two tables it reads.
#
# The important quirk being reproduced: real `loco-pipe start` exits 0 even when
# the workflow fails. FAKE_FAIL=1 makes it print a WorkflowError and still exit
# 0, so CI can prove the module catches it.

set -euo pipefail

ARGV=("$@")

# records the whole invocation, not just the subcommand, so CI can assert on
# the arguments the module actually passed
capture() {
    [ -n "${CI_CAPTURE:-}" ] || return 0
    mkdir -p "$CI_CAPTURE"
    printf '%s\n' "${ARGV[@]}" > "${CI_CAPTURE}/${1}.command.txt"
}

SUBCMD="${1:-}"

case "$SUBCMD" in

    --help|"")
        echo "Usage: loco-pipe [init|start]"
        exit 0
        ;;

    init)
        shift
        OUT="" ; REF="" ; SAMPLES=()
        while [ $# -gt 0 ] ; do
            case "$1" in
                -o) OUT="$2" ; shift 2 ;;
                -r) REF="$2" ; shift 2 ;;
                *)  SAMPLES+=("$1") ; shift ;;
            esac
        done
        [ -n "$OUT" ] || { echo "fake-locopipe: init needs -o" >&2 ; exit 1 ; }
        [ -n "$REF" ] || { echo "fake-locopipe: init needs -r" >&2 ; exit 1 ; }
        [ -f "$REF" ] || { echo "fake-locopipe: no such reference: $REF" >&2 ; exit 1 ; }

        # The real CLI validates SAMPLES with locopipe.validation.BAMfile: at
        # least one is required, each must exist and be readable, and a file
        # must end in .bam ( a directory is globbed for *.bam instead ).
        # Reproduced here because passing the wrong thing was a real bug that a
        # laxer fake let through.
        [ "${#SAMPLES[@]}" -ge 1 ] || {
            echo "Usage: loco-pipe init [OPTIONS] SAMPLES..." >&2
            echo "Error: Missing argument 'SAMPLES...'." >&2 ; exit 1 ; }
        for s in "${SAMPLES[@]}" ; do
            if [ -d "$s" ] ; then
                compgen -G "${s}/*.bam" > /dev/null || {
                    echo "Error: There were no files ending with the accepted alignment extensions .bam (case insensitive) in ${s}." >&2
                    exit 1 ; }
                continue
            fi
            [ -e "$s" ] || { echo "Error: Invalid value for 'SAMPLES...': ${s} was not found." >&2 ; exit 1 ; }
            case "$s" in
                *.bam|*.BAM|*.Bam) : ;;
                *) echo "Error: Invalid value for 'SAMPLES...': ${s} does not end with the accepted extensions for alignment files: .bam (case insensitive)." >&2
                   exit 1 ;;
            esac
            [ -r "$s" ] || { echo "Error: Alignment file ${s} does not have user read permission." >&2 ; exit 1 ; }
        done

        # upstream writes docs/ under the output, and workflow/ into the CURRENT
        # directory, recording scriptdir as an absolute path to it. Laying the
        # tree out beside the project and moving it afterwards leaves that path
        # dangling, which is a real bug this reproduces.
        mkdir -p "${OUT}/docs" workflow/pipelines workflow/scripts
        printf 'sample_name\tbam\tpopulation\nplaceholder\t/dev/null\tgroupname\n' > "${OUT}/docs/samples.tsv"
        printf 'placeholder_contig\t1\n' > "${OUT}/docs/contigs.tsv"
        : > workflow/scripts/get_depth_filter.R
        # A realistic locopipe.yaml, not just the paths: the real one carries
        # every analysis section and is heavily commented, and --locoparams edits
        # it in place. A stub with only `global:` would make an override of a
        # real setting look like a typo.
        cat > "${OUT}/locopipe.yaml" <<CONFIG
global:
  # KEEP_THIS_COMMENT - the merge must not strip comments
  basedir: $(cd "$OUT" && pwd)
  reference: $REF
  scriptdir: $PWD/workflow/scripts
  sample_table: samples.tsv
  pop_level: population
  chr_table: contigs.tsv
  gl_model: 1

snp_calling_global:
  # quoted on purpose: the rules interpolate these into shell commands
  minind_proportion: "0.5"
  minmaf: "0.05"
  pval: "1e-6"

get_depth_filter_global:
  n_sd: 2

subset_snp_list_global:
  # 1 SNP in every n
  n: 3

subset_snp_list_local:
  n: 3

run_pcangsd_global:
  # unquoted here, and must stay untouched when snp_calling_global.minmaf changes
  minmaf: 0.05
CONFIG
        cat > workflow/config.yaml <<'YAML'
directory: .
software-deployment-method: conda
conda-cleanup-pkgs: cache
YAML
        capture init
        exit 0
        ;;

    start)
        shift
        THREADS="" ; DIR="." ; DRY=0
        while [ $# -gt 0 ] ; do
            case "$1" in
                -@) THREADS="$2" ; shift 2 ;;
                -d) DRY=1 ; shift ;;
                *)  DIR="$1" ; shift ;;
            esac
        done

        [ -n "$THREADS" ] || { echo "fake-locopipe: start was not told -@ <threads>" >&2 ; exit 1 ; }

        # Real snakemake writes a source cache here and dies at DAG construction
        # if it is not writable, which is what a read-only $HOME inside a
        # container causes. Assert the caller gave us a usable one.
        [ -n "${XDG_CACHE_HOME:-}" ] || {
            echo "fake-locopipe: XDG_CACHE_HOME is not set; snakemake would fall back to \$HOME/.cache" >&2
            exit 1 ; }
        mkdir -p "$XDG_CACHE_HOME" 2>/dev/null && touch "$XDG_CACHE_HOME/.probe" 2>/dev/null || {
            echo "fake-locopipe: XDG_CACHE_HOME ($XDG_CACHE_HOME) is not writable" >&2
            exit 1 ; }

        # what real loco-pipe reads; a front-end that wrote them wrong fails here
        [ -f "${DIR}/docs/samples.tsv" ] || { echo "fake-locopipe: no ${DIR}/docs/samples.tsv" >&2 ; exit 1 ; }
        [ -f "${DIR}/docs/contigs.tsv" ] || { echo "fake-locopipe: no ${DIR}/docs/contigs.tsv" >&2 ; exit 1 ; }

        head -1 "${DIR}/docs/samples.tsv" | grep -qx "$(printf 'sample_name\tbam\tpopulation')" \
            || { echo "fake-locopipe: bad samples.tsv header: $(head -1 "${DIR}/docs/samples.tsv")" >&2 ; exit 1 ; }

        # conda deployment must have been stripped, or the image is being ignored
        if [ -f "${DIR}/workflow/config.yaml" ] && grep -q 'software-deployment-method' "${DIR}/workflow/config.yaml" ; then
            echo "fake-locopipe: workflow/config.yaml still asks snakemake to build conda envs" >&2
            exit 1
        fi

        # The rules invoke Rscript $scriptdir/<name>.R by the absolute path
        # recorded at init time. If the tree moved afterwards, snakemake fails
        # partway through with "cannot open file", so check it up front.
        SCRIPTDIR=$(sed -n 's/^ *scriptdir: *//p' "${DIR}/locopipe.yaml" | head -1)
        [ -n "$SCRIPTDIR" ] || { echo "fake-locopipe: no scriptdir in ${DIR}/locopipe.yaml" >&2 ; exit 1 ; }
        [ -f "${SCRIPTDIR}/get_depth_filter.R" ] || {
            echo "fake-locopipe: scriptdir recorded in locopipe.yaml does not hold the R scripts: ${SCRIPTDIR}" >&2
            exit 1 ; }

        if [ -n "${CI_CAPTURE:-}" ] ; then
            mkdir -p "$CI_CAPTURE"
            printf '%s\n' "-@" "$THREADS" "$DIR"  > "${CI_CAPTURE}/start.command.txt"
            cp "${DIR}/docs/samples.tsv"            "${CI_CAPTURE}/samples.tsv"
            cp "${DIR}/docs/contigs.tsv"            "${CI_CAPTURE}/contigs.tsv"
        fi

        # snakemake can exit 0 having done nothing, e.g. an empty DAG. The
        # front-end has to treat that as a failure rather than report success
        # with no results.
        if [ "${FAKE_EMPTY:-0}" = "1" ] ; then
            echo "Nothing to be done (all requested files are present and up to date)."
            exit 0
        fi

        # real `loco-pipe start -d` builds the DAG and reports what it would
        # run, producing nothing. A fake that created figures anyway would let a
        # dry run masquerade as a real one.
        if [ "$DRY" = "1" ] ; then
            echo "Building DAG of jobs..."
            echo "Job stats:"
            echo "total    104"
            echo "This was a dry-run (flag -n)."
            exit 0
        fi

        mkdir -p "${DIR}/figures"

        # the upstream quirk: a failed workflow still exits 0
        if [ "${FAKE_FAIL:-0}" = "1" ] ; then
            echo "WorkflowError:"
            echo "At least one job did not complete successfully."
            exit 0
        fi

        echo "104 of 104 steps (100%) done"
        exit 0
        ;;

    *)
        echo "fake-locopipe: unknown subcommand '$SUBCMD'" >&2
        exit 1
        ;;
esac
