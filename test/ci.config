// CI only: shrink the processes to fit a 2 core runner and skip containers,
// since CI runs the fake loco-pipe CLI natively rather than the image.

singularity.enabled = false

// The report needs quarto, which is in the sartools image and not on a runner.
// The dedicated `report` job renders for real; these runs only exercise the
// front-end, and turn it back on with --report true for the stub runs.
params.report = false

process {
  withName:LOCOPIPE        { cpus = 2 ; memory = 4.GB }
  withLabel:process_low    { cpus = 1 ; memory = 2.GB }
  withLabel:process_medium { cpus = 1 ; memory = 2.GB }
  withLabel:process_high   { cpus = 2 ; memory = 4.GB }
}
