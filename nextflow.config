// These params live here rather than in main.nf: nextflow.config is parsed
// before the script, so process directives cannot see script level params.
//
// loco-pipe itself is a Snakemake workflow. This pipeline is a front-end: it
// turns a sample-sheet.csv into the docs/samples.tsv and docs/contigs.tsv that
// loco-pipe expects, then hands off. Everything it shells out to lives in one
// image, so there is a single container for the whole run.
//
// ---- the image --------------------------------------------------------------
// Built locally with containers/build-sif.sh and never pulled.
//
// sifdir defaults to where the image already lives on the TREx server, so a run
// there needs neither --sif nor --sifdir. Elsewhere, give a full path to the
// .sif and nothing else needs to change:
//
//   --sif /some/other/place/loco-pipe.sif
//
params.sifdir       = "/workdir/TREx_shared/projects"
params.sif          = null

// Giving a binary path forces local for the run, since a path on the host only
// makes sense outside an image. Mainly for CI, which has no .sif to run.
params.locopipebin  = null
params.engine       = params.locopipebin ? "local" : "singularity"

// file:// makes it explicit that this is a local image and nothing is fetched.
// Resolved once here so the banner, the directives and the modules agree.
params.image        = params.sif ? "file://${params.sif}" : "file://${params.sifdir}/loco-pipe.sif"
params.container    = params.engine == "local" ? null : params.image

// The directory holding the binary is derived in modules/locopipe, not here:
// `file()` is a script function and is not available while the config is
// being parsed.

// ---- bind mounts ------------------------------------------------------------
// The bams are handed to loco-pipe as paths inside a table, not staged as
// Nextflow inputs, so autoMounts never learns about them and nothing binds the
// directory they live in. Anything outside the site defaults below is then
// invisible inside the image, and loco-pipe reports the file as missing.
//
// So read the sheet here and bind whatever it actually references. Plain
// java.io.File rather than file(), which is a script function and unavailable
// while the config is parsed. Everything is guarded, because this also runs for
// --help and for runs whose sheet does not exist yet.
params.binds        = "/local /workdir"

def sheetBinds = {
    def dirs = [] as Set

    def addPath = { p ->
        if( !p ) return
        try {
            def f = new File(p.toString())
            def d = f.isDirectory() ? f : f.getAbsoluteFile().getParentFile()
            if( d ) dirs << d.getAbsolutePath()
        }
        catch( Exception e ) { }
    }

    addPath(params.ref)

    try {
        def sheet = new File(params.sheet.toString())
        if( sheet.exists() ) {
            def lines = sheet.readLines().findAll { it.trim() }
            if( lines ) {
                def hdr = lines[0].split(',').collect { it.trim().toLowerCase() }
                def bi  = hdr.indexOf('bam')
                if( bi >= 0 ) {
                    lines.drop(1).each { l ->
                        def f = l.split(',').collect { it.trim() }
                        if( f.size() > bi ) addPath(f[bi])
                    }
                }
            }
        }
    }
    catch( Exception e ) { }

    return dirs
}

// site defaults first, then whatever this particular run needs
params.runbinds = (params.binds.tokenize(' ') + sheetBinds())
                    .findAll { it }
                    .unique()
                    .collect { "-B ${it}" }
                    .join(' ')

// ---- resources --------------------------------------------------------------
// loco-pipe runs Snakemake inside a single task and parallelizes internally, so
// LOCOPIPE_RUN is given the whole allocation and told to use exactly that many
// cores. maxforks is per process: 1 means one loco-pipe run at a time, which is
// what you want on a shared box since Snakemake is already using every core.
params.threads      = 32
params.mem          = 200           // GB
params.maxforks     = 1

singularity.enabled     = true
singularity.autoMounts  = true
// the site defaults plus every directory this run's sheet and reference point at
singularity.runOptions  = params.runbinds


process {

  maxForks = params.maxforks

  errorStrategy = { task.attempt <= 2 ? 'retry' : 'finish' }
  maxRetries    = 2

  container = params.container

  // Preparing the tables is cheap; the analysis is not.
  withName:PREPARE_PROJECT {
    cpus   = 2
    memory = 8.GB
  }

  // Snakemake is told exactly what Nextflow reserved, so -@ cannot drift from
  // the actual allocation.
  withName:LOCOPIPE_RUN {
    cpus   = params.threads
    memory = "${params.mem}.GB"
  }

  withLabel:process_low {
    cpus   =    2
    memory =    14.GB

  }
  withLabel:process_medium {
    cpus   =    8
    memory =    32.GB

  }
  withLabel:process_high {
    cpus   =    24
    memory =    200.GB

  }

}


workflow.onComplete = {
    // any workflow property can be used here
    println "Pipeline complete"
    println "Command line: $workflow.commandLine"
}

workflow.onError = {
    println "Error: something went wrong"
}
